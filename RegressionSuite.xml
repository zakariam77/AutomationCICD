<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Regression suite">

    <listeners>
        <listener class-name="Listeners.Listener"/>
        <listener class-name="Listeners.TransformerListener"/>
    </listeners>

    <test name = "End to End buy flow">
        <classes>
            <class name="tests.E2ECheckoutTest"/>
        </classes>
    </test>

    <test name="Parallel DataProvider" parallel="methods" thread-count="6">
        <classes>
            <class name="tests.NegativeTest"/>
        </classes>
    </test>


</suite>