<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="[negative] Error Validation" parallel="methods" thread-count="4">

    <listeners>
        <listener class-name="Listeners.Listener"/>
        <listener class-name="Listeners.TransformerListener"/>
    </listeners>

    <test name = "failLogin testcase">
        <classes>
            <class name="tests.submitOrder">
                <methods>
                    <include name="failLogin"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>