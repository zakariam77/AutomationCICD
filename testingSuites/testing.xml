<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Regression suite" parallel="tests" thread-count="6" >

    <listeners>
        <listener class-name="Listeners.Listener"/>
        <listener class-name="Listeners.TransformerListener"/>
    </listeners>

    <test name = "End to End buy flow">
        <classes>
            <class name="tests.submitOrder"/>
        </classes>
    </test>

    <test name="verify product in cart">
        <classes>
            <class name="tests.VerifyPorduct"/>
        </classes>
    </test>

</suite>